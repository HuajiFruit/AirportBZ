# Scripts run under WSL and macOS; a CRLF checkout on Windows breaks bash
# ("set: pipefail: invalid option name"). Keep them LF in every checkout.
*.sh                text eol=lf
*.py                text eol=lf
# Empty context lines in unified diffs contain one required space.
*.patch             text eol=lf whitespace=-blank-at-eol
# Rewritten by scripts/build-sequoia-bz92.sh on every build.
sources-sequoia.json text eol=lf

# Firmware images and PNVM data.
*.ucode             binary
*.pnvm              binary
